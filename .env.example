# Example environment — copy to .env and fill with real values.
# NEVER commit the real .env (it is gitignored).

DATABASE_URL=file:/home/z/my-project/db/custom.db

# Supabase (publishable/anon key only — safe for frontend). Service role key stays server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Admin authentication (server-only). Generate with:
#   bun run scripts/gen-session-secret.ts
#   bun run scripts/hash-password.ts "<password>"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt:<saltHex>:<hashHex>
SESSION_SECRET=<long-random-string>

# Private storage for uploaded PIX QR (server-only path)
PRIVATE_ASSETS_DIR=/home/z/my-project/private-assets

# --- Initial config (read once by the seed script). Optional. ---
INIT_PAYMENT_CURRENCY=EUR
INIT_PAYMENT_HOLDER=
INIT_PAYMENT_BANK=
INIT_PAYMENT_IBAN=
INIT_PAYMENT_BIC=
INIT_PAYMENT_METHOD=Transferência bancária SEPA
INIT_WHATSAPP_LABEL=
INIT_WHATSAPP_VALUE=
