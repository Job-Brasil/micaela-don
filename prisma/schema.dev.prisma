// Prisma schema — LOCAL DEVELOPMENT ONLY (SQLite)
// This file is used exclusively by the db:*:dev scripts so the sandbox can run
// without a local PostgreSQL instance. It must stay in sync with prisma/schema.prisma.
//
// PRODUCTION uses prisma/schema.prisma (PostgreSQL). Never deploy with this file.
// The model definitions are intentionally identical; only the datasource differs.
// @@map and @map directives match the snake_case names in supabase/schema.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Campaign {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  status      String   @default("draft")
  isDefault   Boolean  @default(false) @map("is_default")
  currency    String   @default("EUR")
  country     String   @default("PT")
  seoTitle    String?  @map("seo_title")
  seoDescription String? @map("seo_description")
  canonicalUrl String? @map("canonical_url")
  deliveryAssetRef String? @map("delivery_asset_ref")
  deliveryDescription String? @map("delivery_description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("campaign")
}

model SiteSetting {
  key         String   @id
  campaignId  String   @default("micaela") @map("campaign_id")
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([campaignId, key])
  @@index([campaignId])
  @@map("site_setting")
}

model SiteAsset {
  id        String   @id @default(cuid())
  name      String
  mime      String
  data      String   @map("image_data")
  width     Int?
  height    Int?
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("site_asset")
}

model PaymentConfig {
  id           String    @id @default(cuid())
  campaignId   String    @default("micaela") @map("campaign_id")
  currency     String    @default("EUR")
  holder       String
  bank         String
  iban         String
  bic          String?
  method       String    @default("SEPA transfer")
  published    Boolean   @default(false)
  approved     Boolean   @default(false)
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([campaignId])
  @@map("payment_config")
}

model PixConfig {
  id              String   @id @default(cuid())
  campaignId      String   @default("micaela") @map("campaign_id")
  qrImageData     String? @map("qr_image_data")
  qrImageMime     String? @map("qr_image_mime")
  beneficiaryName String? @map("beneficiary_name")
  approved        Boolean  @default(false)
  approvedById    String?  @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  published       Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@map("pix_config")
}

model DonationIntent {
  id            String   @id @default(cuid())
  campaignId    String   @default("micaela") @map("campaign_id")
  currency      String
  amount        Float?
  amountMinor   Int?     @map("amount_minor")
  donorName     String?  @map("donor_name")
  donorEmail    String?  @map("donor_email")
  donorWhatsapp String?  @map("donor_whatsapp")
  donorCountry  String?  @map("donor_country")
  paymentMethod String?  @map("payment_method")
  wantPackMedia Boolean  @default(false) @map("want_pack_media")
  message       String?
  status        String   @default("received")
  confirmed     Boolean  @default(false)
  confirmedAt   DateTime? @map("confirmed_at")
  confirmedById String?  @map("confirmed_by_id")
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@index([createdAt])
  @@index([status])
  @@map("donation_intent")
}

model CampaignMaterial {
  id           String   @id @default(cuid())
  campaignId   String   @default("micaela") @map("campaign_id")
  name         String
  category     String
  type         String
  url          String
  source       String   @default("google_drive")
  coverImageRef String? @map("cover_image_ref")
  coverAlt      String? @map("cover_alt")
  description   String?
  published    Boolean  @default(false)
  approved     Boolean  @default(false)
  approvedById String?  @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([campaignId, approved, published])
  @@map("campaign_material")
}

model ThankYouTemplate {
  id        String   @id @default(cuid())
  channel   String
  language  String   @default("pt")
  subject   String?
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("thank_you_template")
}

model ContactChannel {
  id         String   @id @default(cuid())
  campaignId String   @default("micaela") @map("campaign_id")
  type       String
  label      String
  value      String
  enabled    Boolean  @default(false)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@map("contact_channel")
}

model ConsentRecord {
  id         String   @id @default(cuid())
  campaignId String   @default("micaela") @map("campaign_id")
  donorEmail String?  @map("donor_email")
  donorName  String?  @map("donor_name")
  channel    String
  consent    Boolean
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([campaignId, channel, donorEmail])
  @@map("consent_record")
}

model OutboundMessage {
  id                String   @id @default(cuid())
  campaignId        String   @default("micaela") @map("campaign_id")
  toAddress         String   @map("to_address")
  channel           String
  templateId        String?  @map("template_id")
  status            String   @default("pending")
  attempts          Int      @default(0)
  lastError         String?  @map("last_error")
  donationIntentId  String?  @map("donation_intent_id")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([channel, toAddress, donationIntentId])
  @@index([campaignId, status])
  @@map("outbound_message")
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  detail    String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_log")
}

model PaymentOrder {
  id              String   @id @default(cuid())
  campaignId      String   @map("campaign_id")
  donationIntentId String? @map("donation_intent_id")
  provider        String
  method          String
  internalReference String @unique @map("internal_reference")
  currency        String
  amount          Decimal
  status          String   @default("pending")
  externalId      String?  @map("external_id")
  customerEmail   String?  @map("customer_email")
  customerName    String?  @map("customer_name")
  customerPhone   String?  @map("customer_phone")
  deliveryStatus  String   @default("pending") @map("delivery_status")
  metadata        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  confirmedAt     DateTime? @map("confirmed_at")
  refundedAt      DateTime? @map("refunded_at")
  confirmedById   String?  @map("confirmed_by_id")

  @@unique([provider, externalId])
  @@index([campaignId, status])
  @@index([internalReference])
  @@index([customerEmail])
  @@map("payment_order")
}

model PaymentEvent {
  id              String   @id @default(cuid())
  orderId         String?  @map("order_id")
  provider        String
  eventType       String   @map("event_type")
  externalEventId String   @unique @map("external_event_id")
  payloadHash     String?  @map("payload_hash")
  receivedAt      DateTime @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  status          String   @default("pending")

  @@index([orderId])
  @@index([provider, eventType])
  @@map("payment_event")
}

model DeliveryLink {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  token       String   @unique
  assetRef    String   @map("asset_ref")
  expiresAt   DateTime @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("delivery_link")
}
