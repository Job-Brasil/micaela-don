// Prisma schema — LOCAL DEVELOPMENT ONLY (SQLite)
// This file is used exclusively by the db:*:dev scripts so the sandbox can run
// without a local PostgreSQL instance. It must stay in sync with prisma/schema.prisma.
//
// PRODUCTION uses prisma/schema.prisma (PostgreSQL). Never deploy with this file.
// The model definitions are intentionally identical; only the datasource differs.
// @@map and @map directives match the snake_case names in supabase/schema.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Editable public text blocks (hero, story, etc.). Admin-managed.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_setting")
}

model PaymentConfig {
  id           String    @id @default(cuid())
  currency     String    @default("EUR")
  holder       String
  bank         String
  iban         String
  bic          String?
  method       String    @default("SEPA transfer")
  published    Boolean   @default(false)
  approved     Boolean   @default(false)
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("payment_config")
}

model PixConfig {
  id              String   @id @default(cuid())
  qrImageData     String? @map("qr_image_data")
  qrImageMime     String? @map("qr_image_mime")
  beneficiaryName String? @map("beneficiary_name")
  approved        Boolean  @default(false)
  approvedById    String?  @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  published       Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("pix_config")
}

model DonationIntent {
  id            String   @id @default(cuid())
  currency      String
  amount        Float?
  donorName     String?  @map("donor_name")
  donorEmail    String?  @map("donor_email")
  message       String?
  status        String   @default("received")
  confirmed     Boolean  @default(false)
  confirmedAt   DateTime? @map("confirmed_at")
  confirmedById String?  @map("confirmed_by_id")
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@map("donation_intent")
}

model CampaignMaterial {
  id           String   @id @default(cuid())
  name         String
  category     String
  type         String
  url          String
  source       String   @default("google_drive")
  published    Boolean  @default(false)
  approved     Boolean  @default(false)
  approvedById String?  @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([approved, published])
  @@map("campaign_material")
}

model ThankYouTemplate {
  id        String   @id @default(cuid())
  channel   String
  language  String   @default("pt")
  subject   String?
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("thank_you_template")
}

model ContactChannel {
  id        String   @id @default(cuid())
  type      String
  label     String
  value     String
  enabled   Boolean  @default(false)
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_channel")
}

model ConsentRecord {
  id         String   @id @default(cuid())
  donorEmail String?  @map("donor_email")
  donorName  String?  @map("donor_name")
  channel    String
  consent    Boolean
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([channel, donorEmail])
  @@map("consent_record")
}

model OutboundMessage {
  id                String   @id @default(cuid())
  toAddress         String   @map("to_address")
  channel           String
  templateId        String?  @map("template_id")
  status            String   @default("pending")
  attempts          Int      @default(0)
  lastError         String?  @map("last_error")
  donationIntentId  String?  @map("donation_intent_id")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([channel, toAddress, donationIntentId])
  @@index([status])
  @@map("outbound_message")
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  detail    String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_log")
}
