// Prisma schema — "Um Gesto de Apoio (Micaela)"
// PRODUCTION schema: PostgreSQL (used by Vercel + Supabase).
// For local development with SQLite, see prisma/schema.dev.prisma and the
// db:*:dev scripts in package.json. The two schemas must be kept in sync.
//
// This model is mirrored 1:1 in supabase/schema.sql + supabase/rls.sql.
// Status/type fields are String (not enums) validated server-side with zod.
//
// IMPORTANT: @@map and @map directives map Prisma's CamelCase model/field names
// to the snake_case table/column names used in supabase/schema.sql. Without these,
// Prisma looks for "SiteSetting" but the table is "site_setting" → P2021 error.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// A campaign. The Micaela campaign is the default (is_default=true) and is served
/// at "/". Other campaigns are served at "/{slug}". Status validated server-side.
model Campaign {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// draft | published | paused | archived
  status      String   @default("draft")
  isDefault   Boolean  @default(false) @map("is_default")
  /// ISO currency code: EUR, BRL, ...
  currency    String   @default("EUR")
  /// ISO country code: PT, BR, ...
  country     String   @default("PT")
  seoTitle    String?  @map("seo_title")
  seoDescription String? @map("seo_description")
  canonicalUrl String? @map("canonical_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("campaign")
}

/// Editable public text blocks (hero, story, etc.). Admin-managed.
/// Backward compatible: key remains the primary key (existing data preserved).
/// campaignId scopes settings per campaign (default 'micaela').
model SiteSetting {
  key         String   @id
  campaignId  String   @default("micaela") @map("campaign_id")
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([campaignId, key])
  @@index([campaignId])
  @@map("site_setting")
}

/// Uploaded site assets (images) stored as base64 server-side. Used for hero images,
/// material covers, etc. Served via /api/public/asset/[id] (only published assets).
model SiteAsset {
  id        String   @id @default(cuid())
  name      String
  mime      String
  /// Base64-encoded image data. Served via server endpoint, never directly to anon.
  data      String   @map("image_data")
  width     Int?
  height    Int?
  /// When true, the asset may be served publicly (e.g. hero/material cover images).
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("site_asset")
}

/// EUR bank transfer configuration. NEVER published until verified + approved by admin.
model PaymentConfig {
  id           String    @id @default(cuid())
  campaignId   String    @default("micaela") @map("campaign_id")
  currency     String    @default("EUR")
  holder       String
  bank         String
  iban         String
  bic          String?
  method       String    @default("SEPA transfer")
  published    Boolean   @default(false)
  approved     Boolean   @default(false)
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([campaignId])
  @@map("payment_config")
}

/// PIX (BRL) configuration. QR image is private until approved + published.
model PixConfig {
  id              String   @id @default(cuid())
  campaignId      String   @default("micaela") @map("campaign_id")
  qrImageData     String? @map("qr_image_data")
  qrImageMime     String? @map("qr_image_mime")
  beneficiaryName String? @map("beneficiary_name")
  approved        Boolean  @default(false)
  approvedById    String?  @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  published       Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@map("pix_config")
}

/// A donation INTENT. Submitting the form is NOT proof of payment.
model DonationIntent {
  id            String   @id @default(cuid())
  campaignId    String   @default("micaela") @map("campaign_id")
  currency      String
  /// Legacy Float amount (kept for backward compat; use amountMinor for new flows).
  amount        Float?
  /// Amount in minor currency units (cents). This is the canonical value for
  /// financial calculations — never use Float for money.
  amountMinor   Int?     @map("amount_minor")
  donorName     String?  @map("donor_name")
  donorEmail    String?  @map("donor_email")
  donorWhatsapp String?  @map("donor_whatsapp")
  /// ISO country code (PT, BR, ...) — donor's selected/detected region.
  donorCountry  String?  @map("donor_country")
  /// Selected payment method: mbway | pix_automatic | pix_manual | bank_transfer
  paymentMethod String?  @map("payment_method")
  /// Whether the donor opted to receive the Pack Media (digital thank-you materials).
  wantPackMedia Boolean  @default(false) @map("want_pack_media")
  message       String?
  /// pending | received | awaiting_manual_confirmation | paid | failed | cancelled | refunded
  status        String   @default("received")
  confirmed     Boolean  @default(false)
  confirmedAt   DateTime? @map("confirmed_at")
  confirmedById String?  @map("confirmed_by_id")
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@index([createdAt])
  @@index([status])
  @@map("donation_intent")
}

/// Campaign material catalog. Only approved && published appear on the public page.
model CampaignMaterial {
  id           String   @id @default(cuid())
  campaignId   String   @default("micaela") @map("campaign_id")
  name         String
  category     String
  type         String
  url          String
  source       String   @default("google_drive")
  /// Optional cover image. References a SiteAsset id OR an external URL.
  coverImageRef String? @map("cover_image_ref")
  coverAlt      String? @map("cover_alt")
  description   String?
  published    Boolean  @default(false)
  approved     Boolean  @default(false)
  approvedById String?  @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([campaignId, approved, published])
  @@map("campaign_material")
}

/// Editable thank-you message templates per channel.
model ThankYouTemplate {
  id        String   @id @default(cuid())
  channel   String
  language  String   @default("pt")
  subject   String?
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("thank_you_template")
}

/// Contact channels. WhatsApp is DISABLED by default and never shown unless enabled+published.
model ContactChannel {
  id         String   @id @default(cuid())
  campaignId String   @default("micaela") @map("campaign_id")
  type       String
  label      String
  value      String
  enabled    Boolean  @default(false)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@map("contact_channel")
}

/// Explicit, recorded consent per channel. No outbound message without a valid consent.
model ConsentRecord {
  id         String   @id @default(cuid())
  campaignId String   @default("micaela") @map("campaign_id")
  donorEmail String?  @map("donor_email")
  donorName  String?  @map("donor_name")
  channel    String
  consent    Boolean
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([campaignId, channel, donorEmail])
  @@map("consent_record")
}

/// Outbound thank-you messages (future WhatsApp Business / email integration).
model OutboundMessage {
  id                String   @id @default(cuid())
  campaignId        String   @default("micaela") @map("campaign_id")
  toAddress         String   @map("to_address")
  channel           String
  templateId        String?  @map("template_id")
  status            String   @default("pending")
  attempts          Int      @default(0)
  lastError         String?  @map("last_error")
  donationIntentId  String?  @map("donation_intent_id")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([channel, toAddress, donationIntentId])
  @@index([campaignId, status])
  @@map("outbound_message")
}

/// Append-only audit trail for every sensitive action.
model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  detail    String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_log")
}

/// Central payment order — one per payment attempt, across all providers.
/// The internal record created BEFORE calling the provider. provider+externalId
/// is unique to prevent duplicate orders for the same provider charge.
model PaymentOrder {
  id              String   @id @default(cuid())
  campaignId      String   @map("campaign_id")
  /// Optional link to a DonationIntent (for manual PIX / future flows).
  donationIntentId String? @map("donation_intent_id")
  /// stripe | pixgo | manual_pix
  provider        String
  /// mbway | pix_automatic | pix_manual
  method          String
  /// Internal reference, used as client_reference_id / external_id.
  internalReference String @unique @map("internal_reference")
  currency        String
  /// Decimal monetary value (12 digits, 2 decimal places). Use this for all
  /// financial calculations. The legacy Float amount on DonationIntent is kept
  /// for backward compatibility but should NOT be used for new payment orders.
  amount          Decimal  @db.Decimal(12, 2)
  /// pending | processing | paid | failed | expired | cancelled | refunded | requires_manual_review
  status          String   @default("pending")
  /// Provider's charge/session id (e.g. Stripe session id, PixGo payment_id).
  externalId      String?  @map("external_id")
  customerEmail   String?  @map("customer_email")
  customerName    String?  @map("customer_name")
  customerPhone   String?  @map("customer_phone")
  /// Delivery state, independent of payment state.
  /// pending | delivered | failed
  deliveryStatus  String   @default("pending") @map("delivery_status")
  metadata        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  confirmedAt     DateTime? @map("confirmed_at")
  refundedAt      DateTime? @map("refunded_at")
  confirmedById   String?  @map("confirmed_by_id")

  @@unique([provider, externalId])
  @@index([campaignId, status])
  @@index([internalReference])
  @@index([customerEmail])
  @@map("payment_order")
}

/// Idempotent log of webhook events received from providers.
/// externalEventId is unique per provider → prevents duplicate processing.
model PaymentEvent {
  id              String   @id @default(cuid())
  orderId         String?  @map("order_id")
  /// stripe | pixgo
  provider        String
  eventType       String   @map("event_type")
  /// Provider's event id (Stripe event id, PixGo event id).
  externalEventId String   @unique @map("external_event_id")
  /// SHA-256 of the raw payload, for audit/replay verification.
  payloadHash     String?  @map("payload_hash")
  receivedAt      DateTime @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  /// pending | processed | failed
  status          String   @default("pending")

  @@index([orderId])
  @@index([provider, eventType])
  @@map("payment_event")
}

/// Delivery links for digital content. Tokens are unpredictable and expire.
/// One-time use by default (consumedAt set on first access), or multi-access
/// depending on campaign configuration.
model DeliveryLink {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  /// Unpredictable token used in /api/delivery/[token].
  token       String   @unique
  /// Reference to the digital asset (asset:id, storage path, or external URL).
  assetRef    String   @map("asset_ref")
  expiresAt   DateTime @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("delivery_link")
}
